(omi-module metatron.witness
  (source "prompt:metatron-operational-witness")
  (authority
    (declaration executable-candidate)
    (accepted-state false)
    (validation downstream)
    (receipt pending))
  (define-const METATRON-WITNESS 0xAA55)
  (define-const METATRON-INVERSE 0x55AA)
  (define-const WIDTH16 16)
  (define-const BYTE-RING-XOR 0x00)
  (define-const NULL-ORIGIN 0x00)
  (define-const READABLE-BOUNDARY 0x20)
  (define-const SEAL-DELETE-THRESHOLD 0x7F)
  (define-const FULL-CARRIER-HORIZON 0xFF)
  (define-function bit-count4 (n)
    (add
      (band n 1)
      (band (shr n 1) 1)
      (band (shr n 2) 1)
      (band (shr n 3) 1)))
  (define-function bit-count16 (x)
    (add
      (bit-count4 (band x 0xF))
      (bit-count4 (band (shr x 4) 0xF))
      (bit-count4 (band (shr x 8) 0xF))
      (bit-count4 (band (shr x 12) 0xF))))
  (define-function balanced16 (x)
    (eq (bit-count16 x) 8))
  (define-function inverse16 (x)
    (band (bxor x 0xFFFF) 0xFFFF))
  (define-function metatron-witness-register ()
    METATRON-WITNESS)
  (define-function metatron-inverse-register ()
    METATRON-INVERSE)
  (define-function metatron-alternating-pair ()
    (vector METATRON-WITNESS METATRON-INVERSE))
  (define-function dot-xor (car cdr)
    (band (bxor car cdr) 0xFF))
  (define-function byte-ring-xor ()
    BYTE-RING-XOR)
  (define-function byte-ring-closed ()
    (eq (byte-ring-xor) 0x00))
  (define-function metatron-validates-state ()
    false)
  (define-function metatron-accepts-runtime ()
    false)
  (define-function metatron-owns-runtime ()
    false)
  (define-function metatron-scribe-code (validated)
    (if validated 1 -1))
  (define-function metatron-may-scribe (validated)
    (eq (metatron-scribe-code validated) 1))
  (define-function metatron-must-reject (validated)
    (eq (metatron-scribe-code validated) -1))
  (define-function metatron-witness-record (value validated)
    (vector value validated (metatron-scribe-code validated)))
  (define-function witness-record-value (record)
    (at record 0))
  (define-function witness-record-validated (record)
    (at record 1))
  (define-function witness-record-scribe-code (record)
    (at record 2))
  (test alternating-registers
    (expect (metatron-witness-register) 0xAA55)
    (expect (metatron-inverse-register) 0x55AA)
    (expect (inverse16 METATRON-WITNESS) METATRON-INVERSE)
    (expect (inverse16 METATRON-INVERSE) METATRON-WITNESS)
    (expect (at (metatron-alternating-pair) 0) 0xAA55)
    (expect (at (metatron-alternating-pair) 1) 0x55AA))
  (test balanced-witnesses
    (expect (bit-count16 METATRON-WITNESS) 8)
    (expect (bit-count16 METATRON-INVERSE) 8)
    (expect (balanced16 METATRON-WITNESS) true)
    (expect (balanced16 METATRON-INVERSE) true))
  (test dot-xor-ring
    (expect (dot-xor NULL-ORIGIN READABLE-BOUNDARY) 0x20)
    (expect (dot-xor READABLE-BOUNDARY SEAL-DELETE-THRESHOLD) 0x5F)
    (expect (dot-xor SEAL-DELETE-THRESHOLD FULL-CARRIER-HORIZON) 0x80)
    (expect (dot-xor FULL-CARRIER-HORIZON NULL-ORIGIN) 0xFF)
    (expect (byte-ring-xor) 0x00)
    (expect (byte-ring-closed) true))
  (test scribe-boundary
    (expect (metatron-may-scribe true) true)
    (expect (metatron-may-scribe false) false)
    (expect (metatron-must-reject false) true)
    (expect (metatron-must-reject true) false)
    (expect (witness-record-scribe-code (metatron-witness-record 0xAA55 true)) 1)
    (expect (witness-record-scribe-code (metatron-witness-record 0xAA55 false)) -1))
  (test authority-boundary
    (expect (metatron-validates-state) false)
    (expect (metatron-accepts-runtime) false)
    (expect (metatron-owns-runtime) false)))
