(omi-module canon.orbit
  (source "/home/main/omi/omi-isa/lib/omi_orbit.c")
  (source "/home/main/omi/omi-canon/dev-docs/OMI Canon Runtime Atlas.md")
  (authority
    (declaration executable-candidate)
    (accepted-state false)
    (validation downstream)
    (receipt pending))
  (define-const OMI-SLOT5040-SIZE 5040)
  (define-function gf16-mul-alpha (x)
    (u16
      (if (ne (band x 0x8000) 0)
        (bxor (shl x 1) 0x002D)
        (shl x 1))))
  (define-function orbit-delta16 (x c)
    (u16 (bxor (gf16-mul-alpha x) c)))
  (define-function orbit-step-x (x c)
    (orbit-delta16 x c))
  (define-function fano (x)
    (mod x 7))
  (define-function tetra (x)
    (mod x 4))
  (define-function phase (x)
    (band x 1))
  (define-function bqf (x y)
    (add
      (mul 60 x x)
      (mul 16 x y)
      (mul 4 y y)))
  (define-function slot5040 (fano-id tetra-class delta-phase)
    (mod
      (add
        (mul fano-id 720)
        (mul tetra-class 240)
        (mod delta-phase 240))
      OMI-SLOT5040-SIZE))
  (define-function attest-orbit-id (x trace-position)
    (slot5040 (fano x) (tetra x) (mod trace-position 240)))
  (define-function attest-fano-id (x)
    (fano x))
  (define-function attest-tetra-class (x)
    (tetra x))
  (define-function attest-delta-phase (trace-position)
    (band trace-position 0xFF))
  (test gl16-delta
    (expect (gf16-mul-alpha 0x0001) 0x0002)
    (expect (gf16-mul-alpha 0x8000) 0x002D)
    (expect (orbit-delta16 0x1234 0x00FF) 0x2497))
  (test observers
    (expect (fano 0x1234) 5)
    (expect (tetra 0x1234) 0)
    (expect (phase 0x1234) 0)
    (expect (bqf 3 5) 880))
  (test atlas
    (expect (slot5040 3 2 17) 2657)
    (expect (attest-orbit-id 0x1234 300) 3660)
    (expect (attest-fano-id 0x1234) 5)
    (expect (attest-tetra-class 0x1234) 0)
    (expect (attest-delta-phase 300) 44)))
