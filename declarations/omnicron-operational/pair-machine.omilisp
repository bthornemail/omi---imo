(omi-module omnicron.pair-machine
  (source "/home/main/omi/omnicron/pair-machine.c")
  (authority
    (declaration executable-candidate)
    (accepted-state false)
    (validation downstream)
    (receipt pending))
  (define-const TAG-MASK 0xC000)
  (define-const TAG-INT 0x0000)
  (define-const TAG-SYM 0x4000)
  (define-const TAG-REF 0x8000)
  (define-const TAG-SPEC 0xC000)
  (define-const PAYLOAD-MASK 0x3FFF)
  (define-const SPEC-NIL 0xC000)
  (define-const SPEC-TRUE 0xC001)
  (define-function pair-cons8 (car cdr)
    (bor
      (shl (band car 0xFF) 8)
      (band cdr 0xFF)))
  (define-function pair-car8 (pair)
    (band (shr pair 8) 0xFF))
  (define-function pair-cdr8 (pair)
    (band pair 0xFF))
  (define-function make-int (n)
    (bor TAG-INT (band n PAYLOAD-MASK)))
  (define-function make-symbol (n)
    (bor TAG-SYM (band n PAYLOAD-MASK)))
  (define-function make-ref (n)
    (bor TAG-REF (band n PAYLOAD-MASK)))
  (define-function tag-of (value)
    (band value TAG-MASK))
  (define-function payload-of (value)
    (band value PAYLOAD-MASK))
  (define-function is-int (value)
    (eq (tag-of value) TAG-INT))
  (define-function is-symbol (value)
    (eq (tag-of value) TAG-SYM))
  (define-function is-ref (value)
    (eq (tag-of value) TAG-REF))
  (define-function is-special (value)
    (eq (tag-of value) TAG-SPEC))
  (define-function is-nil (value)
    (eq value SPEC-NIL))
  (define-function is-true (value)
    (eq value SPEC-TRUE))
  (test pair-roundtrip
    (expect (pair-cons8 0x12 0xAB) 0x12AB)
    (expect (pair-car8 0x12AB) 0x12)
    (expect (pair-cdr8 0x12AB) 0xAB))
  (test value-tags
    (expect (tag-of (make-int 42)) TAG-INT)
    (expect (tag-of (make-symbol 5)) TAG-SYM)
    (expect (tag-of (make-ref 4095)) TAG-REF)
    (expect (payload-of (make-int 0xFFFF)) PAYLOAD-MASK))
  (test special-values
    (expect (is-nil SPEC-NIL) true)
    (expect (is-true SPEC-TRUE) true)
    (expect (is-special SPEC-NIL) true)))
