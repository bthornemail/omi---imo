(omi-module canon.envelope-bitboard
  (source "/home/main/omi/omi-isa/lib/omienv.c")
  (source "/home/main/omi/omi-canon/dev-docs/OMI Canon Runtime Atlas.md")
  (authority
    (declaration executable-candidate)
    (accepted-state false)
    (validation downstream)
    (receipt pending))
  (define-const OMI-ENV-SIZE 64)
  (define-const OMI-PREHEADER-SIZE 8)
  (define-const U64-MASK 0xFFFFFFFFFFFFFFFF)
  (define-const OMI-BB-GAUGE-MASK 0x000000000000007F)
  (define-const OMI-BB-DPLUS-SHIFT 7)
  (define-const OMI-BB-DPLUS-MASK 0x0000000000001F80)
  (define-const OMI-BB-DMINUS-SHIFT 12)
  (define-const OMI-BB-DMINUS-MASK 0x000000000001E000)
  (define-const OMI-BB-BRIDGE-1E-BIT 17)
  (define-const OMI-BB-BRIDGE-78-BIT 18)
  (define-const OMI-BB-SEAL-7F-BIT 19)
  (define-const OMI-BB-BOOT-7C00-BIT 20)
  (define-const OMI-BB-BRIDGE-AA55-BIT 21)
  (define-const OMI-BB-PLACE-SHIFT 22)
  (define-const OMI-BB-PLACE-MASK 0x00000000FFC00000)
  (define-const OMI-BB-RESULT-SHIFT 32)
  (define-const OMI-BB-RESULT-MASK 0x0000FFFF00000000)
  (define-const OMI-BB-FOLD-SHIFT 48)
  (define-const OMI-BB-FOLD-MASK 0xFFFF000000000000)
  (define-const CANONICAL-PREHEADER (bytes 0xFF 0x00 0x1C 0x1D 0x1E 0x1F 0x20 0xFF))
  (define-function canonical-preheader-valid (gauge)
    (if (not (eq-bytes gauge CANONICAL-PREHEADER))
      -2
      (if (ne (byte-at gauge 0) (byte-at gauge 7))
        -3
        (if (lt (byte-at gauge 0) 0xF0)
          -4
          (if (or
                (ne (byte-at gauge 2) 0x1C)
                (ne (byte-at gauge 3) 0x1D)
                (ne (byte-at gauge 4) 0x1E)
                (ne (byte-at gauge 5) 0x1F))
            -5
            (if (ne (byte-at gauge 6) 0x20) -6 0))))))
  (define-function bb-set-gauge (board code)
    (bor
      (band board (bxor U64-MASK OMI-BB-GAUGE-MASK))
      (band code 0x7F)))
  (define-function bb-set-flag (board bit)
    (bor board (shl 1 bit)))
  (define-function bb-get-flag (board bit)
    (band (shr board bit) 1))
  (define-function bb-get-gauge (board)
    (band board OMI-BB-GAUGE-MASK))
  (define-function bb-get-place (board)
    (band (shr board OMI-BB-PLACE-SHIFT) 0x3FF))
  (define-function bb-get-result (board)
    (band (shr board OMI-BB-RESULT-SHIFT) 0xFFFF))
  (define-function bb-dplus (board)
    (band (shr board OMI-BB-DPLUS-SHIFT) 0x1F))
  (define-function bb-dminus (board)
    (band (shr board OMI-BB-DMINUS-SHIFT) 0x1F))
  (define-function dplus-nibble (n)
    (if (or (eq n 0) (eq n 5) (eq n 0xA) (eq n 0xF)) 1 0))
  (define-function dminus-nibble (n)
    (if (or (eq n 3) (eq n 6) (eq n 9) (eq n 0xC)) 1 0))
  (define-function dplus-byte (byte)
    (add (dplus-nibble (band (shr byte 4) 0xF)) (dplus-nibble (band byte 0xF))))
  (define-function dminus-byte (byte)
    (add (dminus-nibble (band (shr byte 4) 0xF)) (dminus-nibble (band byte 0xF))))
  (define-function bb-apply-dplus (board byte)
    (bor
      (band board (bxor U64-MASK OMI-BB-DPLUS-MASK))
      (shl (band (add (bb-dplus board) (dplus-byte byte)) 0x1F) OMI-BB-DPLUS-SHIFT)))
  (define-function bb-apply-dminus (board byte)
    (bor
      (band board (bxor U64-MASK OMI-BB-DMINUS-MASK))
      (shl (band (add (bb-dminus board) (dminus-byte byte)) 0x1F) OMI-BB-DMINUS-SHIFT)))
  (define-function bb-apply-place (board place)
    (bor
      (band board (bxor U64-MASK OMI-BB-PLACE-MASK))
      (shl (band place 0x3FF) OMI-BB-PLACE-SHIFT)))
  (define-function bb-apply-result (board byte)
    (bor
      (band board (bxor U64-MASK OMI-BB-RESULT-MASK))
      (shl (bxor (bb-get-result board) byte) OMI-BB-RESULT-SHIFT)))
  (define-function bb-apply (board byte place)
    (if (gt place 31)
      board
      (bb-apply-result
        (bb-apply-place
          (bb-apply-dminus
            (bb-apply-dplus board byte)
            byte)
          place)
        byte)))
  (define-function bb-fold (board)
    (bor
      (band board (bxor U64-MASK OMI-BB-FOLD-MASK))
      (shl (band (bxor (band board 0xFFFFFFFF) (shr board 32)) 0xFFFF) OMI-BB-FOLD-SHIFT)))
  (test envelope-validation
    (expect OMI-ENV-SIZE 64)
    (expect (canonical-preheader-valid CANONICAL-PREHEADER) 0)
    (expect (canonical-preheader-valid (bytes 0xFF 0x00 0x1C 0x1D 0x1E 0x1F 0x21 0xFF)) -2))
  (test bitboard-basic
    (expect (bb-get-gauge (bb-set-gauge 0 0xFF)) 0x7F)
    (expect (bb-get-flag (bb-set-flag 0 OMI-BB-BRIDGE-78-BIT) OMI-BB-BRIDGE-78-BIT) 1)
    (expect (bb-get-place (bb-apply 0 0x3C 9)) 9)
    (expect (bb-get-result (bb-apply 0 0x3C 9)) 0x3C)
    (expect (bb-dplus (bb-apply 0 0xA5 1)) 2)
    (expect (bb-dminus (bb-apply 0 0x3C 1)) 2)
    (expect (bb-fold 0x1234567800000000) 0x5678567800000000)))
